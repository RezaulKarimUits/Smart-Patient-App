# Copy to .env and set the API address the device can reach (restart `npx expo start` after changes).
# Android emulator -> host machine:
EXPO_PUBLIC_API_URL=http://10.0.2.2:5080
# iOS simulator / web on the same PC:
# EXPO_PUBLIC_API_URL=http://localhost:5080
# Phone on the same Wi-Fi (use your PC's LAN IP from `ipconfig`):
# EXPO_PUBLIC_API_URL=http://192.168.0.10:5080
